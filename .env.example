# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Public site URL used by SEO metadata, robots.txt, and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://www.a3ter1a.cn

# ScheduleWidget read-only monthly planning API — keep the token server-side only.
# Use a long random value and never put it in the client bundle, URL, or repository.
BLOG_PLANNING_READ_TOKEN=replace_with_a_long_random_read_only_token
# Comma-separated exact origins allowed for browser-based ScheduleWidget requests.
# Leave empty for server-to-server requests without an Origin header.
BLOG_PLANNING_ALLOWED_ORIGINS=

# Admin protection
# Comma-separated Supabase Auth email(s) allowed to use server-only admin APIs.
ADMIN_EMAILS=your_admin_email@example.com

# DeepSeek AI (text analysis) — server-side, preferred over Settings panel
DEEPSEEK_API_KEY=your_deepseek_api_key

# WP3 bounded internal jobs — keep false until 0014 lease RPC and 0020 private OCR image config pass remote rehearsal and rollout approval
WP3_INTERNAL_JOB_LEASE_ENABLED=false

# English shared training ledger — keep legacy until 0016-0018 are deployed and verified
ENGLISH_TRAINING_CORE_MODE=legacy

# Math shared training ledger — keep local until 0019 is deployed and verified
MATH_TRAINING_CORE_MODE=local

# Qwen Vision AI (OCR) — server-side, preferred over Settings panel
QWEN_API_KEY=your_qwen_api_key

# Baidu Unlimited OCR (PDF lecture parsing) — server-side only
BAIDU_OCR_API_KEY=your_baidu_ocr_api_key
BAIDU_OCR_SECRET_KEY=your_baidu_ocr_secret_key
